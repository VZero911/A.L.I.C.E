# The Seed — BETA (public) environment template.
#
# This is the PRODUCTION-shaped template the go-live kit uses (the beta runbook lists a real
# .env.beta.example as still-to-build in The Seed; this is the kit's own copy). deploy.sh copies it
# to the server as .env.beta ONLY if that file is absent, then fills the dynamic values from $DOMAIN
# and generates the secrets. It is NEVER overwritten once it exists, and no secret is ever printed.
#
# What deploy.sh sets for you on first create (do NOT fill these by hand here — leave them as shown):
#   POSTGRES_PASSWORD   a fresh strong random value
#   JWT_SECRET          a fresh strong random value
#   CORS_ORIGINS        ["https://play.<domain>","https://app.<domain>"]
#   SIWE_DOMAINS        ["play.<domain>","app.<domain>"]
#   SIWE_DOMAIN         play.<domain>          (primary SIWE domain)
#   COOKIE_DOMAIN       .<domain>              (session cookie shared by play. and app.)
#   PUBLIC_URL          https://<domain>       (apex / showcase)
#   PUBLIC_API_URL      https://api.<domain>
#   VITE_API_URL / EXPO_PUBLIC_* / VITE_CHAIN_ID   the public https URLs for the built front
#   CONSOLE_ALLOWLIST   whatever you pass (empty => the admin console stays CLOSED)
#
# Everything else below is a safe beta default. Review the chain + contract values before a real
# beta (that is V's step, per docs/runbooks/beta.md): the RPC URL and the deployed addresses.
#
# This file is a TEMPLATE and holds NO secret. Keep real secrets only in .env.beta on the server.

# --- Postgres (the compose stack) -------------------------------------------------------
POSTGRES_USER=theseed
# Left empty on purpose: deploy.sh generates a strong random password on first create.
POSTGRES_PASSWORD=
POSTGRES_DB=theseed

# --- Chain: Base Sepolia testnet (beta is a closed testnet beta, chain 84532) ------------
# NOT local Anvil (there is no Anvil on the server). Confirm/replace the RPC before a real beta:
# a public RPC is rate-limited; an Alchemy/Infura Base Sepolia URL is steadier.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Backend ----------------------------------------------------------------------------
# Not 'local'/'test' => the backend ENFORCES production safety: JWT_SECRET required,
# DEV_ENDPOINTS must be off, GAME_OPERATOR must not be 'unlocked' (config.py validators).
ENVIRONMENT=beta
# Overridden by compose (environment: DATABASE_URL -> postgres service); kept here for clarity.
DATABASE_URL=postgresql+psycopg://theseed@postgres:5432/theseed
BACKEND_PORT=8000

# Filled from $DOMAIN by deploy.sh. The game (play.) and the web tool (app.) are the only origins
# allowed to call the API and to sign in. Same registrable domain as api. => SameSite=Strict cookies
# travel play.->api. and app.->api.
CORS_ORIGINS=["https://play.example.org","https://app.example.org"]
SIWE_DOMAINS=["play.example.org","app.example.org"]
# Primary SIWE domain for single-origin sign-in checks (the game). Filled from $DOMAIN by deploy.sh.
SIWE_DOMAIN=play.example.org
# Cookie domain, leading dot => the session cookie is shared across play. and app. subdomains.
# Filled from $DOMAIN by deploy.sh.
COOKIE_DOMAIN=.example.org
NONCE_TTL_SECONDS=300

# Access-token signing key: deploy.sh generates a random one on first create. REQUIRED here.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# HTTPS is on at the edge (Caddy), so the refresh cookie MUST be Secure. Never 'false' on the server.
COOKIE_SECURE=true

# Public base URL of the site (apex / showcase) as clients see it (filled from $DOMAIN by deploy.sh).
PUBLIC_URL=https://example.org
# Public base URL of the API as clients see it (filled from $DOMAIN by deploy.sh).
PUBLIC_API_URL=https://api.example.org

# The dev mint endpoint uses unlocked node accounts: impossible and unsafe on a public network.
DEV_ENDPOINTS=false
# No unlocked accounts on a public network: the game operator needs its own signer (ADR 0015 /
# beta runbook §2.3). 'disabled' until V wires the keystore/KMS signer.
GAME_OPERATOR=disabled

# Per-IP and per-account rate limits on, maintenance flag off, invites required for a closed beta.
RATE_LIMITS=true
MAINTENANCE=false
BETA_INVITES_REQUIRED=true

# --- Admin (V) --------------------------------------------------------------------------
# Public addresses only, never a key. Set V's real address before a beta. The system-admin password
# for the console sign-in goes ONLY in .env.beta on the server (SYSTEM_ADMIN_PASSWORD=), never here.
# V_ADDRESS=0x...
# ADMIN_ADDRESSES=["0x..."]
# SYSTEM_ADMIN_PASSWORD=

# --- Admin console gate (edge) ----------------------------------------------------------
# Space-separated IPs/CIDRs allowed to reach console.<domain>. EMPTY => the console is CLOSED
# (403 for everyone) until V lists IPs or uses a VPN. deploy.sh passes whatever you give it.
# If you front DNS with Cloudflare, use DNS-only (grey cloud) for console. so the real client IP
# reaches Caddy; behind the orange-cloud proxy the allowlist sees Cloudflare's IPs, not the client.
CONSOLE_ALLOWLIST=

# --- Indexer (Base Sepolia: ~2s blocks, public RPCs cap eth_getLogs ranges) -------------
INDEXER_CONFIRMATIONS=5
INDEXER_BATCH_SIZE=500
INDEXER_POLL_INTERVAL=2.0

# --- Front (build-time; baked into game/dist and web/dist, filled from $DOMAIN by deploy.sh) ---
VITE_API_URL=https://api.example.org
VITE_RPC_URL=https://sepolia.base.org
VITE_CHAIN_ID=84532
EXPO_PUBLIC_API_URL=https://api.example.org
EXPO_PUBLIC_RPC_URL=https://sepolia.base.org
EXPO_PUBLIC_CHAIN_ID=84532
EXPO_PUBLIC_SIWE_DOMAIN=play.example.org
